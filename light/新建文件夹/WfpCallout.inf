; WfpCallout.inf
[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
DriverVer=08/28/2024,1.0.0.0

[Manufacturer]
%ManufacturerName%=Standard,NTamd64

[Standard.NTamd64]
%DeviceName%=DriverInstall, Root\WfpCallout

[DriverInstall]
CopyFiles=DriverCopyFiles

[DriverCopyFiles]
WfpCallout.sys

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
WfpCallout.sys = 1

[DestinationDirs]
DriverCopyFiles = 12

[DriverInstall.Services]
AddService=WfpCallout,0x00000002,DriverService

[DriverService]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\WfpCallout.sys
AddReg=DriverAddReg

[DriverAddReg]
HKR,,,,%DeviceName%
HKR,,DebugLevel,0x00010001,0

[Strings]
ManufacturerName="Light Security"
DeviceName="WFP Callout Driver"
ServiceName="WfpCallout"
DiskName="WfpCallout Installation Disk"
