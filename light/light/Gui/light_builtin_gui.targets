<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Imported by light.vcxproj immediately before Microsoft.Cpp.targets.
       Gui/*.cpp are already listed in light.vcxproj and must not be duplicated. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ProjectDir);$(ProjectDir)Gui;$(WebView2SDKDir)\build\native\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;NOMINMAX;_CRT_SECURE_NO_WARNINGS;_WINSOCK_DEPRECATED_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories Condition="'$(Platform)'=='x64'">$(WebView2SDKDir)\build\native\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalLibraryDirectories Condition="'$(Platform)'=='Win32'">$(WebView2SDKDir)\build\native\x86;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>WebView2LoaderStatic.lib;gdiplus.lib;comctl32.lib;ole32.lib;oleaut32.lib;uuid.lib;shell32.lib;uxtheme.lib;comdlg32.lib;winhttp.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <!-- QuickJS-NG C runtime: compile as C, not as C++. -->
    <!-- QuickJS uses intentional unsigned wraparound in bit/LEB128 operations.
         Keep MSVC warning C4146 disabled only for this third-party translation unit. -->
    <ClCompile Include="$(ProjectDir)quickjs.c">
      <CompileAs>CompileAsC</CompileAs>
      <DisableSpecificWarnings>4146;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
    <!-- QuickJS libc calls POSIX CRT aliases on Windows; silence those deprecation
         diagnostics only for this source file, not for the whole application. -->
    <ClCompile Include="$(ProjectDir)quickjs-libc.c">
      <CompileAs>CompileAsC</CompileAs>
      <PreprocessorDefinitions>_CRT_NONSTDC_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <DisableSpecificWarnings>4996;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
    <ClCompile Include="$(ProjectDir)dtoa.c"><CompileAs>CompileAsC</CompileAs></ClCompile>
    <ClCompile Include="$(ProjectDir)libregexp.c"><CompileAs>CompileAsC</CompileAs></ClCompile>
    <ClCompile Include="$(ProjectDir)libunicode.c"><CompileAs>CompileAsC</CompileAs></ClCompile>
  </ItemGroup>
</Project>
